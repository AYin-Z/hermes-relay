<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal theme — Compose handles all theming via Material 3.
         forceDarkAllowed=false: OEM force-dark must not invert an explicit Light
         preference while the activity still hosts a DayNight parent. Night mode
         is locked from Appearance via AppCompatDelegate (AppearanceNightMode). -->
    <style name="Theme.HermesRelay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
